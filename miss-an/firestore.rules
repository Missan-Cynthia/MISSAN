rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/missAnOwners/$(uid));
    }
    match /users/{uid}/core/locations {
      function valid() {
        let data = request.resource.data;
        return data.keys().hasOnly(['schemaVersion', 'version', 'operationId', 'records']) &&
          data.schemaVersion == 1 && data.version is int &&
          data.operationId is string && data.records is map;
      }
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && valid() && request.resource.data.version == 1;
      allow update: if isOwner(uid) && valid() &&
        request.resource.data.version == resource.data.version + 1;
    }
    match /users/{uid}/core/access {
      allow get: if isOwner(uid);
    }
  }
}
